{
  "name": "claude-org",
  "version": "4.0.0",
  "description": "SQLite-backed orchestrator for repository work with provider routing, isolated worktrees, verification, and assessment",
  "type": "module",
  "bin": {
    "claude-org": "./orchestrator.js",
    "posse": "./orchestrator.js",
    "posse-agent": "./registered-agent.js"
  },
  "scripts": {
    "add": "node orchestrator.js add",
    "queue": "node orchestrator.js queue",
    "plan": "node orchestrator.js plan",
    "run": "node orchestrator.js run",
    "status": "node orchestrator.js status",
    "health": "node orchestrator.js health",
    "automation": "node orchestrator.js automation",
    "dashboard": "node orchestrator.js dashboard",
    "update": "node orchestrator.js update",
    "review": "node orchestrator.js review",
    "inject": "node orchestrator.js inject",
    "go": "node orchestrator.js go",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "posse-shared-trunk-smoke": "node orchestrator.js shared-trunk-smoke --json",
    "check:protocol": "node scripts/check-control-protocol-drift.mjs",
    "pull:native": "node scripts/pull-native-artifacts.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "13.0.3",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1-beta.2",
    "mysql2": "^3.22.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
